# ARIA WhatsApp Bot — Environment Configuration
# Copy this to .env and fill in your keys

# ── WhatsApp Connection ──────────────────────────────────────────
# For QR code login: leave PHONE_NUMBER empty
# For pairing code login: set your phone number (with country code, no +)
PHONE_NUMBER=
# Bot name used to trigger AI responses (default: aria)
BOT_NAME=aria
# Prefix for text commands (default: !)
BOT_PREFIX=!
# Your WhatsApp number that gets full owner permissions (no +, full format)
OWNER_NUMBER=

# ── AI Providers (at least one required) ────────────────────────
# Fallback chain: Cerebras → Gemini → Groq → OpenRouter
# The bot tries them in this order and falls through if one fails

# Cerebras — 1M tokens/day free, highest free ceiling
# Get key at: https://console.cerebras.ai/
CEREBRAS_API_KEY=

# Gemini — 1,500 requests/day free, 1M token context
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — fast inference, free tier available
# Get key at: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter — fallback if all others fail
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Web Search ───────────────────────────────────────────────────
# Tavily is required for web search. Get key at: https://tavily.com/
TAVILY_API_KEY=
# Optional: Brave Search fallback. Get key at: https://brave.com/search/api/
BRAVE_API_KEY=

# ── Optional Features ────────────────────────────────────────────
# ElevenLabs TTS — text-to-speech voice notes
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ── Server ───────────────────────────────────────────────────────
PORT=3001

# ── Sandbox ─────────────────────────────────────────────────────
# Docker image used for sandboxed code execution (!run). Requires Docker
# on the host. If Docker isn't available, code execution is blocked.
SANDBOX_IMAGE=node:20-slim

# ── Debug ────────────────────────────────────────────────────────
# Set to "true" to see full AI reply context in console
DEBUG_REPLIES=false

# VPN generator — shadowsocks password (was hardcoded)
VPN_SS_PASSWORD=aria-ss-2026

# Web Dashboard — password to access browser control panel
DASHBOARD_PASSWORD=your-secure-password
