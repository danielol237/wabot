# ARIA WhatsApp Bot — Environment Configuration
# Copy this to .env and fill in your keys

# ── WhatsApp Connection ──────────────────────────────────────────
# For QR code login: leave PHONE_NUMBER empty
# For pairing code login: set your phone number (with country code, no +)
PHONE_NUMBER=
# Bot name used to trigger AI responses (default: aria)
BOT_NAME=aria
# Optional legacy prefix for text commands. Leave empty for natural-language-first mode.
# The legacy ! prefix remains accepted during migration even when this is empty.
BOT_PREFIX=
# Your WhatsApp number that gets full owner permissions (no +, full format)
OWNER_NUMBER=
# Chat ID where ARIA sends proactive/alerts (proactive monitor pushes alerts
# here). Usually your own DM JID, e.g. "<number>@s.whatsapp.net" or "<lid>@lid".
OWNER_CHAT_ID=
# View-once media (photos/videos/voice that expire after viewing) is ephemeral
# by design. Auto-forwarding it to your DM is a privacy-sensitive behavior, so it
# is OFF unless you explicitly opt in. When enabled, every save is audit-logged.
SAVE_VIEW_ONCE=false

# ── AI Providers (at least one required) ────────────────────────
# Fallback chain: Cerebras → Gemini → Groq → OpenRouter
# The bot tries them in this order and falls through if one fails

# Cerebras — 1M tokens/day free, highest free ceiling
# Get key at: https://console.cerebras.ai/
CEREBRAS_API_KEY=

# Gemini — 1,500 requests/day free, 1M token context
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — fast inference, free tier available
# Get key at: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter — fallback if all others fail
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Web Search ───────────────────────────────────────────────────
# Tavily is required for web search. Get key at: https://tavily.com/
TAVILY_API_KEY=
# Optional: Brave Search fallback. Get key at: https://brave.com/search/api/
BRAVE_API_KEY=

# ── Optional Features ────────────────────────────────────────────
# ElevenLabs TTS — text-to-speech voice notes
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ── Server ───────────────────────────────────────────────────────
PORT=3001
# Canonical public origin used by WhatsApp learner/anime links, without a trailing slash.
BASE_URL=http://localhost:3001
# Optional separate origin if the public anime site is hosted elsewhere.
ANIME_PUBLIC_URL=
# Optional Atlas V3 Sentinel webhook secrets. Leave blank to keep external
# webhooks disabled. Configure the matching repository/service mapping in Atlas.
GITHUB_WEBHOOK_SECRET=
RENDER_WEBHOOK_SECRET=
# Maximum time spent waiting on one anime source before trying the next provider.
ANIME_PROVIDER_TIMEOUT_MS=18000
# Pin the production media runtime so yt-dlp and its JavaScript solver stay compatible.
YTDLP_VERSION=2026.7.4
YTDLP_EJS_VERSION=0.8.0
# WhatsApp upload ceiling in MB; 150 MB covers typical 360p/480p episodes.
ANIME_WHATSAPP_MAX_MB=150
# Signed playback/download capability secret; use a long random value in Render.
MEDIA_PROXY_SECRET=replace-with-a-long-random-secret
# Optional comma-separated HTTPS host allowlist for configured media providers.
MEDIA_ALLOWED_HOSTS=
# Completed browser media retention and orphan-part cleanup windows.
ANIME_MEDIA_RETENTION_MS=21600000
ANIME_ORPHAN_RETENTION_MS=86400000
# Required signing key for learner portal sessions and link-code forms.
PORTAL_SESSION_SECRET=replace-with-a-long-random-secret
# Optional Google OAuth login. In Google Cloud, add this exact redirect URI:
# https://your-public-origin.example/portal/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback; recommended when Render has multiple public domains.
# For this service: https://wabot-ytal.onrender.com/portal/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Session Persistence (fixes QR re-scan on Render free) ─────
# Render free wipes disk on restart, killing the WhatsApp session. Back it up
# to a PRIVATE git repo and auto-restore so you don't re-scan QR every deploy.
# Create a private repo, then set:
SESSION_GIT_REPO=
# e.g. youruser/aria-session (MUST be a private repo — it holds WhatsApp creds)
GITHUB_TOKEN=
# seconds between auto-sync of the session (default 60)
SESSION_SYNC_INTERVAL=60
# Required dedicated 32+ character key for encrypting WhatsApp session backups.
# Do not derive this from GITHUB_TOKEN; rotating a GitHub token must not break restore.
SESSION_ENCRYPT_KEY=replace-with-another-long-random-secret

# ── Commercial platform sessions ───────────────────────────────
# Dedicated HMAC secret for customer/workspace login sessions.
PLATFORM_SESSION_SECRET=

# ── Android Companion API ──────────────────────────────────────
# Required before the Android app can call /api/companion/chat.
# Use a separate long random secret; never reuse a provider or GitHub token.
COMPANION_API_KEY=

# ── Optional product connectors ─────────────────────────────────
# Official Pinterest API token for image batches; public fallback remains available when empty.
PINTEREST_ACCESS_TOKEN=
# Vercel token for owner-controlled generated-project delivery; deployment stays disabled when empty.
VERCEL_TOKEN=
# Z.AI is limited to image, video, and vision generation; text providers are unchanged.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://api.z.ai/v1
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_VIDEO_MODEL=cogvideox-3

# ── Companion expression ───────────────────────────────────────
# Artificial typos and long reply delays are disabled by default.
ARIA_HUMANIZER_TYPOS=false
ARIA_HUMANIZER_DELAY=false
ARIA_RANDOM_MOOD=false

# ── Platform commercial controls ───────────────────────────────
# Safe defaults: payment capture and outbound autopilot are disabled.
ARIA_LIVE_PAYMENTS=false
# Background platform job worker cadence; keep >=15000ms in production.
PLATFORM_JOB_INTERVAL_MS=30000
# Never enable outbound execution until a provider-specific sender and approval policy are configured.
ARIA_AUTOPILOT_LIVE=false
# Optional JSON plan overrides for operator-controlled pricing/quotas.
ARIA_PLAN_OVERRIDES_JSON=
# Provider secrets are intentionally not guessed; add only after official merchant onboarding.
MTN_WEBHOOK_SECRET=
ORANGE_WEBHOOK_SECRET=

# ── Public anime quotas ─────────────────────────────────────────
# Per-client-IP limits for anonymous browser downloads.
ANIME_PUBLIC_DOWNLOADS_PER_HOUR=10
ANIME_PUBLIC_ACTIVE_LIMIT=3
ANIME_PUBLIC_QUEUE_LIMIT=100

# ── Warmup Mode ────────────────────────────────────────────────
# Set to "true" on a fresh WhatsApp number to keep ARIA reply-only.
# Disables autonomous check-ins + background task poller so a new account
# doesn't get flagged for automated activity. Remove once the number is mature.
ARIA_WARMUP=false

# ── Sandbox ─────────────────────────────────────────────────────
# Docker image used for sandboxed code execution (!run). Requires Docker
# on the host. If Docker isn't available, code execution is blocked.
SANDBOX_IMAGE=node:22-slim

# ── Debug ────────────────────────────────────────────────────────
# Set to "true" to see full AI reply context in console
DEBUG_REPLIES=false

# VPN generator — required shadowsocks password (never use a committed default)
VPN_SS_PASSWORD=

# Web Dashboard — password to access browser control panel
DASHBOARD_PASSWORD=your-secure-password
